---
import { getCV, useTranslations, type Lang } from '@/i18n'
import Section from '@/components/Section.astro'
import Button from '@/components/ui/Button.astro'
import { Icon } from 'astro-icon/components'
interface Props {
  lang: Lang;
  className?: string;
}

const { lang } = Astro.props
const t = useTranslations(lang)
const { basics } = getCV(lang)
const { name, role, location, email } = basics
const { city, region, address } = location
---

<Section className={Astro.props.className}>
  <div class="flex flex-col gap-3">
    <div>
      <h1 data-ccursor="lift" class="w-fit text-4xl font-bold print:text-3xl">{name}</h1>
      <p data-ccursor="noPadding" class="mt-1 font-roboto-condensed font-medium text-xl text-skin-hue lg:text-base">
        {role}
      </p>
    </div>
    <div data-ccursor="noPadding" class="flex w-fit items-center gap-2 text-sm text-skin-muted">
      <Icon class="print:hidden" name="mdi:world" width={18} height={18} />
      {address}, {city}, {region}
    </div>
    <div class="hidden print:block"><b>{t.contact} </b>{email}</div>
    <div class="flex gap-2 print:hidden">
      {
        basics.profiles.map(({ network, url, icon, color }) => (
          <Button
            href={url}
            variant="outline"
            size="icon"
            class="group"
            target="_blank"
            rel="noreferrer noopener"
            aria-label={t.opensInNewTab(network)}
            data-umami-event={`${network} click`}
            data-ccursor
            id={network}
          >
            <Icon
              name={icon}
              width={20}
              height={20}
              class="grayscale transition-all group-hover:grayscale-0"
              style={`color: ${color};`}
              aria-label={network}
            />
          </Button>
        ))
      }
    </div>
  </div>
</Section>
