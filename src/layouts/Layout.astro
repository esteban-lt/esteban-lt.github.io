---
import "@fancyapps/ui/dist/fancybox/fancybox.css";
import '../globals.css';
import { defaultLang, getCV, getPath, locales, useTranslations, type Lang } from "@/i18n";

interface Props {
  lang?: Lang;
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  lang = defaultLang,
  title,
  image: imageProp,
  canonicalURL: canonicalProp,
  description: descriptionProp,
} = Astro.props;

const CV = getCV(lang);
const t = useTranslations(lang);
const image = imageProp ?? CV.basics.image;
const description = descriptionProp ?? t.description;
const { url, theme, name, location } = CV.basics;
const pageUrl = (target: Lang) => new URL(getPath(target), url).toString();
const canonicalURL = canonicalProp ?? pageUrl(lang);
const { city, region } = location;

const currentJob = CV.work?.find((job) => !job.endDate);
const institution = CV.education?.[0]?.institution;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": name,
  "alternateName": "Esteban",
  "jobTitle": currentJob?.position ?? CV.basics.role,
  "url": canonicalURL,
  "email": CV.basics.email,
  "alumniOf": institution && {
    "@type": "EducationalOrganization",
    "name": institution
  },
  "knowsLanguage": CV.languages?.map(l => l.language),
  "sameAs": CV.basics.profiles.map(profile => profile.url),
  "image": new URL(image, url).toString(),
  "description": CV.basics.summary,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": city,
    "addressRegion": region,
    "addressCountry": "MX"
  },
  "knowsAbout": CV.skills.map(skill => skill.name),
  "worksFor": currentJob && {
    "@type": "Organization",
    "name": currentJob.name
  }
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Apply dark/light mode before first paint: avoids a flash of the wrong theme -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var isDark = stored
            ? stored === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', isDark);
        } catch (e) {}
      })();
    </script>

    <!-- On the default-language root, send first-time visitors with an English browser to /en/ -->
    {lang === defaultLang && (
      <script is:inline>
        (function () {
          try {
            if (location.pathname !== '/') return;
            if (localStorage.getItem('lang')) {
              if (localStorage.getItem('lang') === 'en') location.replace('/en/' + location.search + location.hash);
              return;
            }
            var preferred = (navigator.languages && navigator.languages[0]) || navigator.language || '';
            if (preferred.toLowerCase().indexOf('en') === 0) location.replace('/en/' + location.search + location.hash);
          } catch (e) {}
        })();
      </script>
    )}

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={name} />
    <meta name="geo.region" content="MX-CHH" />
    <meta name="geo.placename" content={city} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={pageUrl('es')} />
    <link rel="alternate" hreflang="en" href={pageUrl('en')} />
    <link rel="alternate" hreflang="x-default" href={pageUrl(defaultLang)} />
    
    <!-- Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, url)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${name} — ${CV.basics.role}`} />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:locale" content={locales[lang].og} />
    <meta property="og:locale:alternate" content={locales[lang === 'es' ? 'en' : 'es'].og} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content={url.split("//")[1] ?? ""} />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, url)} />
    {(() => {
      const twitterHandle = CV.basics.profiles.find(p => p.network === 'X / Twitter')?.username;
      return twitterHandle && <meta name="twitter:creator" content={twitterHandle} />;
    })()}
    
    <!-- Additional meta tags -->
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <meta name="referrer" content="no-referrer" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    
    {CV?.analyticsCode && <script is:inline src={CV.analyticsCode} />}
    <meta name="google-site-verification" content="oi4G-5FCwNn5m9MvSyjyBxVatgwi8KT_KtVuC9Pckmg" />
  </head>
  <body data-theme={theme} class="relative bg-skin-fill font-sans">
    <div class="absolute top-0 -z-10 h-full w-full print:hidden">
      <div class="absolute bottom-auto left-[20%] right-auto top-0 h-[200px] w-[200px] -translate-x-[30%] translate-y-[20%] rounded-full bg-skin-hue/10 blur-[80px] invert-0 dark:bg-white/5"></div>
    </div>
    <div class="absolute inset-0 -z-10 h-full w-full bg-white bg-[linear-gradient(to_right,#f0f0f0_1px,transparent_1px),linear-gradient(to_bottom,#f0f0f0_1px,transparent_1px)] bg-[size:6rem_4rem] dark:bg-skin-fill dark:bg-[linear-gradient(to_right,rgba(255,255,255,0.05)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.05)_1px,transparent_1px)]"></div>
    <slot />
    <script src="../scripts/main.ts"></script>
  </body>
</html>

<style>

  body{
    * {
    @apply rounded-lg;
    -webkit-user-drag: none;
    }
  }

  @media (min-width: 640px) {
    body * {
      cursor: none !important;
    }
  }
  
  a {
    text-decoration: none;
  }
  
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  
  h1,
  h2,
  h3,
  h4 {
    @apply text-skin-base font-sans;
    margin: 0;
  }
  
  p {
    @apply text-sm text-skin-muted;
    line-height: 1.5;
    text-wrap: pretty;
  }
  
  .print {
    display: none !important;
  }
  
  .dev * {
    @apply border border-red-500/50 bg-red-500/5;
  }

  ::-webkit-scrollbar {
    width: 2px;
  }
  
  @media print {
    .print {
      display: block !important;
    }
    
    astro-dev-toolbar {
      display: none !important;
    }
    
    article {
      break-inside: avoid;
    }
  }
</style>
